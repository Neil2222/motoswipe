{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": { "parser": "svelte" }
		},
		{
			"files": "*.md",
			"options": { "useTabs": false, "printWidth": 80, "proseWrap": "preserve" }
		},
		{
			"files": "*.prisma",
			"options": { "useTabs": false }
		}
	]
}
