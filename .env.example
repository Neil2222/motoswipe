# ---------------------------------------------------------------------------
# MotoSwipe environment
#
# Copy to `.env` for local development:   cp .env.example .env
# For Docker Compose, copy to `.env` too — compose reads it automatically.
# NEVER commit a real .env. Generate every secret; do not reuse an example.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Credentials the Postgres container is created with.
POSTGRES_USER=motoswipe
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=motoswipe

# Connection string used by the app and by the Prisma CLI.
#
# Pick ONE of the two lines below.
#
#  - Running everything in Docker: the host is the compose service name.
#      postgresql://motoswipe:PASSWORD@postgres:5432/motoswipe?schema=public
#
#  - Running `npm run dev` on the host against the compose database: use
#    localhost and the published port (see POSTGRES_PORT below).
#      postgresql://motoswipe:PASSWORD@localhost:5433/motoswipe?schema=public
#
# docker-compose.yml sets DATABASE_URL for the app container itself, so this
# value is what the *host* tooling (dev server, prisma CLI, tests) uses.
DATABASE_URL=postgresql://motoswipe:change-me-postgres-password@localhost:5433/motoswipe?schema=public

# Host port the Postgres container publishes (bound to 127.0.0.1 only). This is
# how `npm run dev` and the test suite reach the database. 5433 avoids clashing
# with a Postgres already installed on the machine.
#
# docker-compose.prod.yml publishes no database port at all.
POSTGRES_PORT=5433

# --- Application -----------------------------------------------------------
# Port the app listens on inside the container / locally.
PORT=3000

# Published host port for the app container. Behind Caddy you normally bind
# this to loopback only (see README) or remove it and use a shared network.
APP_PORT=3000

# `production` enables Secure cookies, strict security headers and hides
# stack traces. Anything else is treated as development.
NODE_ENV=production

# Public origin the app is served from, including scheme. REQUIRED in
# production: SvelteKit uses it to validate the Origin header on form posts
# (CSRF), and the app uses it for absolute URLs. Behind Caddy this is your
# public hostname, NOT localhost.
ORIGIN=https://motoswipe.example.com

# Trust the X-Forwarded-For / X-Forwarded-Proto headers from exactly one
# upstream proxy. Set to 1 when running behind Caddy/nginx/Traefik, 0 when the
# app is directly exposed. Trusting a proxy that is not there lets clients
# spoof their address.
TRUST_PROXY_HOPS=1

# --- Sessions --------------------------------------------------------------
# Secret used to derive session-token hashes. MUST be set in production and
# MUST be unique per deployment. Rotating it invalidates every session.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Session lifetime in days. Sessions are sliding: activity past the halfway
# point extends them.
SESSION_TTL_DAYS=30

# --- Registration ----------------------------------------------------------
# Set to `false` to close public sign-up once your friends have accounts.
ALLOW_REGISTRATION=true

# Registrations allowed per client address per hour. Rate limiting keys on the
# client address, and everyone behind one home router shares one — so a family
# setting up several accounts in an afternoon needs this above the default.
# Lower it if the instance is open to the internet.
REGISTRATIONS_PER_HOUR=10

# --- Data imports ----------------------------------------------------------
# Identifies this instance to Wikimedia's API when running the `wikipedia`
# importer. Their API policy asks for a contact address or URL in the
# User-Agent; supplying one is the difference between being a good citizen and
# being rate-limited or blocked. Only used by `npm run import:run`.
WIKIMEDIA_CONTACT=you@example.com

# --- Development seed accounts --------------------------------------------
# Used ONLY by `npm run db:seed`. If unset, the seed script generates a random
# password and prints it once. Never set these in production.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=test@example.local
SEED_USER_PASSWORD=
